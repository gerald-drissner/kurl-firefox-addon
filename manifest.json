{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "kURL",
  "version": "2.0.0",
  "author": "Gerald Drißner",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "kurl@drissner.me",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "48": "images/kurl-icon-48.png",
    "96": "images/kurl-icon-96.png"
  },
  "background": {
    "scripts": [
      "JS/polyfill.js",
      "JS/helpers.js",
      "JS/background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "kURL"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "menus",
    "notifications",
    "activeTab",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
