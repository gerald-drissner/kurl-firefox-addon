{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "kURL",
  "version": "2.0.2",
  "author": "Gerald Drißner",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "kurl@drissner.me",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "icons": {
    "16": "images/kurl-icon-16.png",
    "32": "images/kurl-icon-32.png",
    "48": "images/kurl-icon-48.png",
    "96": "images/kurl-icon-96.png",
    "128": "images/kurl-icon-128.png"
  },
  "background": {
    "scripts": [
      "JS/polyfill.js",
      "JS/helpers.js",
      "JS/background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "kURL",
    "default_icon": {
      "16": "images/kurl-icon-16.png",
      "32": "images/kurl-icon-32.png"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "menus",
    "notifications",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
